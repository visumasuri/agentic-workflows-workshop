# Set these in your shell (export NAME=value).
# With GROQ_API_KEY set the workshop calls Groq. Without it, it runs on the offline mock.
# GROQ_API_KEY=gsk_...          free key from console.groq.com
# LLM_PROVIDER=mock             force offline mode even when a key is set
MAIN_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
